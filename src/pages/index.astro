---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ShaderCanvas from '@/components/ShaderCanvas.astro';
---

<BaseLayout title="Atmospheric Weather Shader Sandbox">
  <ShaderCanvas />

  <aside class="sandbox-panel" id="sandbox-panel" aria-label="Weather & Atmosphere Shader Controls">
    <header class="panel-header">
      <div class="panel-title-wrap">
        <span class="status-dot"></span>
        <h1 class="panel-title">Weather Shader Controls</h1>
      </div>
      <button type="button" class="collapse-btn" id="toggle-panel-btn" title="Collapse / Expand Controls">
        Hide UI
      </button>
    </header>

    <div class="panel-body" id="panel-body">
      <!-- Live Location Quick Sync -->
      <section class="control-section">
        <div class="section-label">
          <span>Live Location Feed</span>
          <span class="live-readout" id="live-status-text">Afternoon · Sunny</span>
        </div>
        <div class="chip-grid cols-2">
          <button type="button" class="ctrl-chip" id="btn-live-host">
            📍 My Location (<span id="host-mini-label">New York</span>)
          </button>
          <button type="button" class="ctrl-chip" id="btn-live-visitor">
            🧭 Visitor (<span id="visitor-mini-label">Detecting…</span>)
          </button>
        </div>
      </section>

      <!-- Time of Day -->
      <section class="control-section">
        <div class="section-label">
          <span>Time of Day</span>
        </div>
        <div class="chip-grid cols-3" id="time-presets">
          <button type="button" class="ctrl-chip" data-time="dawn">🌅 Dawn</button>
          <button type="button" class="ctrl-chip" data-time="morning">🌤 Morning</button>
          <button type="button" class="ctrl-chip is-active" data-time="afternoon">☀ Afternoon</button>
          <button type="button" class="ctrl-chip" data-time="dusk">🌇 Dusk</button>
          <button type="button" class="ctrl-chip" data-time="evening">🌆 Evening</button>
          <button type="button" class="ctrl-chip" data-time="night">🌙 Night</button>
        </div>
      </section>

      <!-- Weather Patterns -->
      <section class="control-section">
        <div class="section-label">
          <span>Weather Pattern</span>
        </div>
        <div class="chip-grid cols-3" id="weather-presets">
          <button type="button" class="ctrl-chip is-active" data-weather="sunny">☀ Sunny</button>
          <button type="button" class="ctrl-chip" data-weather="partly">⛅ Partly Cloudy</button>
          <button type="button" class="ctrl-chip" data-weather="cloudy">🌥 Mostly Cloudy</button>
          <button type="button" class="ctrl-chip" data-weather="overcast">☁ Overcast</button>
          <button type="button" class="ctrl-chip" data-weather="fog">🌫 Fog / Mist</button>
          <button type="button" class="ctrl-chip" data-weather="slight-rain">🌦 Slight Rain</button>
          <button type="button" class="ctrl-chip" data-weather="more-rain">🌧 More Rain</button>
          <button type="button" class="ctrl-chip" data-weather="heavy-rain">🌊 Downpour</button>
          <button type="button" class="ctrl-chip" data-weather="thunderstorm">⛈ Storm</button>
          <button type="button" class="ctrl-chip" data-weather="light-snow">🌨 Light Snow</button>
          <button type="button" class="ctrl-chip" data-weather="blizzard">❄ Blizzard</button>
          <button type="button" class="ctrl-chip" data-weather="rainbow">🌈 Sunshower</button>
          <button type="button" class="ctrl-chip" data-weather="dust">🏜 Sand / Dust</button>
          <button type="button" class="ctrl-chip" data-weather="aurora">🌌 Aurora</button>
        </div>
      </section>

      <!-- Fine-Tuning Sliders -->
      <section class="control-section">
        <div class="section-label">
          <span>Shader Parameters</span>
          <button type="button" class="reset-link" id="reset-params-btn">Reset</button>
        </div>

        <div class="sliders-list">
          <label class="slider-row">
            <span class="slider-name">Sun Elevation</span>
            <input type="range" min="-1" max="1" step="0.01" value="0.85" data-param="sunElevation" />
            <span class="slider-val" data-val="sunElevation">0.85</span>
          </label>

          <label class="slider-row">
            <span class="slider-name">Sun Position X</span>
            <input type="range" min="0.05" max="0.95" step="0.01" value="0.11" data-param="sunAzimuth" />
            <span class="slider-val" data-val="sunAzimuth">0.11</span>
          </label>

          <label class="slider-row">
            <span class="slider-name">Cloud Cover</span>
            <input type="range" min="0" max="1" step="0.01" value="0.24" data-param="cloudCover" />
            <span class="slider-val" data-val="cloudCover">24%</span>
          </label>

          <label class="slider-row">
            <span class="slider-name">Cloud Volume</span>
            <input type="range" min="0" max="2" step="0.02" value="1.0" data-param="cloudDensity" />
            <span class="slider-val" data-val="cloudDensity">100%</span>
          </label>

          <label class="slider-row">
            <span class="slider-name">Sun Rays (God Rays)</span>
            <input type="range" min="0" max="2" step="0.02" value="1.0" data-param="godRays" />
            <span class="slider-val" data-val="godRays">100%</span>
          </label>

          <label class="slider-row">
            <span class="slider-name">HDR Bloom Glow</span>
            <input type="range" min="0" max="1.8" step="0.02" value="0.92" data-param="bloomStrength" />
            <span class="slider-val" data-val="bloomStrength">92%</span>
          </label>

          <label class="slider-row">
            <span class="slider-name">Rain Intensity</span>
            <input type="range" min="0" max="1" step="0.01" value="0" data-param="rain" />
            <span class="slider-val" data-val="rain">0%</span>
          </label>

          <label class="slider-row">
            <span class="slider-name">Snow Intensity</span>
            <input type="range" min="0" max="1" step="0.01" value="0" data-param="snow" />
            <span class="slider-val" data-val="snow">0%</span>
          </label>

          <label class="slider-row">
            <span class="slider-name">Fog / Mist</span>
            <input type="range" min="0" max="1" step="0.01" value="0" data-param="fog" />
            <span class="slider-val" data-val="fog">0%</span>
          </label>

          <label class="slider-row">
            <span class="slider-name">Storm &amp; Lightning</span>
            <input type="range" min="0" max="1" step="0.01" value="0" data-param="storm" />
            <span class="slider-val" data-val="storm">0%</span>
          </label>

          <label class="slider-row">
            <span class="slider-name">Wind Speed</span>
            <input type="range" min="0" max="3" step="0.05" value="1.0" data-param="windSpeed" />
            <span class="slider-val" data-val="windSpeed">1.0x</span>
          </label>

          <label class="slider-row">
            <span class="slider-name">Dust / Sand Haze</span>
            <input type="range" min="0" max="1" step="0.01" value="0" data-param="dust" />
            <span class="slider-val" data-val="dust">0%</span>
          </label>

          <label class="slider-row">
            <span class="slider-name">Optical Rainbow</span>
            <input type="range" min="0" max="1" step="0.01" value="0" data-param="rainbow" />
            <span class="slider-val" data-val="rainbow">0%</span>
          </label>

          <label class="slider-row">
            <span class="slider-name">Aurora Borealis</span>
            <input type="range" min="0" max="1" step="0.01" value="0" data-param="aurora" />
            <span class="slider-val" data-val="aurora">0%</span>
          </label>
        </div>
      </section>
    </div>
  </aside>
</BaseLayout>

<script>
  import {
    HOST_LOCATION,
    detectVisitorLocation,
    fetchWeatherForLocation
  } from '@/services/weatherService';
  import {
    DEFAULT_SHADER_TARGET,
    type ShaderWeatherTarget
  } from '@/webgl/ShaderStage';
  import type { WeatherState } from '@/config/weather';

  let currentTarget: ShaderWeatherTarget = { ...DEFAULT_SHADER_TARGET };
  let activeTimeName = 'Afternoon';
  let activeWeatherName = 'Sunny';
  let hostState: WeatherState | null = null;
  let visitorState: WeatherState | null = null;

  // 6 Time-of-day solar profiles
  const TIME_PRESETS: Record<
    string,
    { label: string; sunElevation: number; sunAzimuth: number; godRays: number }
  > = {
    dawn: { label: 'Dawn', sunElevation: 0.04, sunAzimuth: 0.16, godRays: 1.25 },
    morning: { label: 'Morning', sunElevation: 0.45, sunAzimuth: 0.14, godRays: 1.15 },
    afternoon: { label: 'Afternoon', sunElevation: 0.85, sunAzimuth: 0.11, godRays: 1.05 },
    dusk: { label: 'Dusk', sunElevation: 0.08, sunAzimuth: 0.82, godRays: 1.35 },
    evening: { label: 'Evening', sunElevation: -0.18, sunAzimuth: 0.78, godRays: 0.45 },
    night: { label: 'Night', sunElevation: -0.75, sunAzimuth: 0.22, godRays: 0.3 }
  };

  // 14 Weather Pattern Profiles
  const WEATHER_PRESETS: Record<
    string,
    { label: string; params: Partial<ShaderWeatherTarget> }
  > = {
    sunny: {
      label: 'Sunny',
      params: {
        cloudCover: 0.22,
        cloudDensity: 1.0,
        godRays: 1.1,
        fog: 0,
        dust: 0,
        rain: 0,
        snow: 0,
        storm: 0,
        windSpeed: 0.9,
        rainbow: 0,
        aurora: 0
      }
    },
    partly: {
      label: 'Partly Cloudy',
      params: {
        cloudCover: 0.46,
        cloudDensity: 1.15,
        godRays: 1.15,
        fog: 0,
        dust: 0,
        rain: 0,
        snow: 0,
        storm: 0,
        windSpeed: 1.1,
        rainbow: 0,
        aurora: 0
      }
    },
    cloudy: {
      label: 'Mostly Cloudy',
      params: {
        cloudCover: 0.72,
        cloudDensity: 1.25,
        godRays: 0.85,
        fog: 0.08,
        dust: 0,
        rain: 0,
        snow: 0,
        storm: 0.15,
        windSpeed: 1.25,
        rainbow: 0,
        aurora: 0
      }
    },
    overcast: {
      label: 'Overcast',
      params: {
        cloudCover: 0.94,
        cloudDensity: 1.4,
        godRays: 0.25,
        fog: 0.22,
        dust: 0,
        rain: 0,
        snow: 0,
        storm: 0.35,
        windSpeed: 1.1,
        rainbow: 0,
        aurora: 0
      }
    },
    fog: {
      label: 'Fog / Mist',
      params: {
        cloudCover: 0.65,
        cloudDensity: 0.95,
        godRays: 0.65,
        fog: 0.82,
        dust: 0,
        rain: 0,
        snow: 0,
        storm: 0.1,
        windSpeed: 0.5,
        rainbow: 0,
        aurora: 0
      }
    },
    'slight-rain': {
      label: 'Slight Rain',
      params: {
        cloudCover: 0.68,
        cloudDensity: 1.15,
        godRays: 0.45,
        fog: 0.18,
        dust: 0,
        rain: 0.32,
        snow: 0,
        storm: 0.22,
        windSpeed: 1.1,
        rainbow: 0,
        aurora: 0
      }
    },
    'more-rain': {
      label: 'Moderate Rain',
      params: {
        cloudCover: 0.85,
        cloudDensity: 1.3,
        godRays: 0.2,
        fog: 0.3,
        dust: 0,
        rain: 0.65,
        snow: 0,
        storm: 0.45,
        windSpeed: 1.55,
        rainbow: 0,
        aurora: 0
      }
    },
    'heavy-rain': {
      label: 'Downpour',
      params: {
        cloudCover: 0.96,
        cloudDensity: 1.5,
        godRays: 0.1,
        fog: 0.42,
        dust: 0,
        rain: 0.95,
        snow: 0,
        storm: 0.68,
        windSpeed: 2.2,
        rainbow: 0,
        aurora: 0
      }
    },
    thunderstorm: {
      label: 'Thunderstorm',
      params: {
        cloudCover: 0.98,
        cloudDensity: 1.6,
        godRays: 0.15,
        fog: 0.32,
        dust: 0,
        rain: 0.92,
        snow: 0,
        storm: 0.98,
        windSpeed: 2.5,
        rainbow: 0,
        aurora: 0
      }
    },
    'light-snow': {
      label: 'Light Snow',
      params: {
        cloudCover: 0.72,
        cloudDensity: 1.15,
        godRays: 0.45,
        fog: 0.25,
        dust: 0,
        rain: 0,
        snow: 0.42,
        storm: 0.18,
        windSpeed: 0.85,
        rainbow: 0,
        aurora: 0
      }
    },
    blizzard: {
      label: 'Blizzard',
      params: {
        cloudCover: 0.96,
        cloudDensity: 1.5,
        godRays: 0.1,
        fog: 0.68,
        dust: 0,
        rain: 0,
        snow: 0.98,
        storm: 0.55,
        windSpeed: 2.6,
        rainbow: 0,
        aurora: 0
      }
    },
    rainbow: {
      label: 'Sunshower & Rainbow',
      params: {
        cloudCover: 0.42,
        cloudDensity: 1.05,
        godRays: 1.35,
        fog: 0.05,
        dust: 0,
        rain: 0.24,
        snow: 0,
        storm: 0,
        windSpeed: 1.0,
        rainbow: 0.95,
        aurora: 0
      }
    },
    dust: {
      label: 'Sand / Dust Haze',
      params: {
        cloudCover: 0.45,
        cloudDensity: 0.9,
        godRays: 0.95,
        fog: 0.35,
        dust: 0.85,
        rain: 0,
        snow: 0,
        storm: 0.15,
        windSpeed: 2.1,
        rainbow: 0,
        aurora: 0
      }
    },
    aurora: {
      label: 'Aurora Sky',
      params: {
        sunElevation: -0.78,
        cloudCover: 0.18,
        cloudDensity: 0.85,
        godRays: 0.25,
        fog: 0,
        dust: 0,
        rain: 0,
        snow: 0,
        storm: 0,
        windSpeed: 0.7,
        rainbow: 0,
        aurora: 0.95
      }
    }
  };

  const formatSliderVal = (key: keyof ShaderWeatherTarget, val: number): string => {
    if (key === 'sunElevation' || key === 'sunAzimuth') return val.toFixed(2);
    if (key === 'windSpeed') return `${val.toFixed(1)}x`;
    return `${Math.round(val * 100)}%`;
  };

  const syncSlidersFromState = () => {
    (Object.keys(currentTarget) as Array<keyof ShaderWeatherTarget>).forEach((key) => {
      const input = document.querySelector<HTMLInputElement>(`input[data-param="${key}"]`);
      const label = document.querySelector<HTMLElement>(`[data-val="${key}"]`);
      const val = currentTarget[key];
      if (input) input.value = String(val);
      if (label) label.textContent = formatSliderVal(key, val);
    });

    const statusEl = document.getElementById('live-status-text');
    if (statusEl) {
      statusEl.textContent = `${activeTimeName} · ${activeWeatherName}`;
    }
  };

  const pushToShader = () => {
    syncSlidersFromState();
    window.dispatchEvent(new CustomEvent('weather:preset', { detail: { ...currentTarget } }));
  };

  // Time preset clicks
  document.querySelectorAll<HTMLButtonElement>('[data-time]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-time') || 'afternoon';
      const t = TIME_PRESETS[key];
      if (!t) return;

      document.querySelectorAll('[data-time]').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      document
        .querySelectorAll('#btn-live-host, #btn-live-visitor')
        .forEach((b) => b.classList.remove('is-active'));

      activeTimeName = t.label;
      currentTarget.sunElevation = t.sunElevation;
      currentTarget.sunAzimuth = t.sunAzimuth;
      currentTarget.godRays = t.godRays;
      if (key !== 'night' && key !== 'evening') {
        currentTarget.aurora = 0;
      }
      pushToShader();
    });
  });

  // Weather pattern clicks
  document.querySelectorAll<HTMLButtonElement>('[data-weather]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-weather') || 'sunny';
      const w = WEATHER_PRESETS[key];
      if (!w) return;

      document.querySelectorAll('[data-weather]').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      document
        .querySelectorAll('#btn-live-host, #btn-live-visitor')
        .forEach((b) => b.classList.remove('is-active'));

      activeWeatherName = w.label;
      currentTarget = {
        ...currentTarget,
        ...w.params
      };

      // If Aurora is picked during daytime, switch time to Night so it shines clearly
      if (key === 'aurora') {
        activeTimeName = 'Night';
        document.querySelectorAll('[data-time]').forEach((b) => {
          b.classList.toggle('is-active', b.getAttribute('data-time') === 'night');
        });
      }
      pushToShader();
    });
  });

  // Individual slider adjustments
  document.querySelectorAll<HTMLInputElement>('input[data-param]').forEach((input) => {
    input.addEventListener('input', () => {
      const key = input.getAttribute('data-param') as keyof ShaderWeatherTarget;
      const val = parseFloat(input.value);
      currentTarget[key] = val;

      const label = document.querySelector<HTMLElement>(`[data-val="${key}"]`);
      if (label) label.textContent = formatSliderVal(key, val);

      window.dispatchEvent(new CustomEvent('weather:preset', { detail: { ...currentTarget } }));
    });
  });

  // Reset button
  document.getElementById('reset-params-btn')?.addEventListener('click', () => {
    currentTarget = { ...DEFAULT_SHADER_TARGET };
    activeTimeName = 'Afternoon';
    activeWeatherName = 'Sunny';
    document.querySelectorAll('[data-time]').forEach((b) => {
      b.classList.toggle('is-active', b.getAttribute('data-time') === 'afternoon');
    });
    document.querySelectorAll('[data-weather]').forEach((b) => {
      b.classList.toggle('is-active', b.getAttribute('data-weather') === 'sunny');
    });
    pushToShader();
  });

  // Collapse / Expand Panel button
  const panel = document.getElementById('sandbox-panel');
  const toggleBtn = document.getElementById('toggle-panel-btn');
  toggleBtn?.addEventListener('click', () => {
    const collapsed = panel?.classList.toggle('is-collapsed');
    if (toggleBtn) toggleBtn.textContent = collapsed ? 'Show Controls' : 'Hide UI';
  });

  // Live Location buttons (Nabhi vs Visitor)
  const applyLiveWeatherState = (state: WeatherState, sourceBtnId: string) => {
    document
      .querySelectorAll('[data-time], [data-weather], #btn-live-host, #btn-live-visitor')
      .forEach((b) => b.classList.remove('is-active'));
    document.getElementById(sourceBtnId)?.classList.add('is-active');

    const isFog = state.weatherCode === 45 || state.weatherCode === 48;
    currentTarget = {
      ...currentTarget,
      sunElevation: state.sunElevation,
      sunAzimuth: 0.12,
      cloudCover: state.cloudCover,
      cloudDensity: 1.05,
      godRays: state.isDay ? 1.05 : 0.35,
      fog: isFog ? 0.7 : 0,
      dust: 0,
      rain: state.precipitation,
      snow: state.snowAmount,
      storm: state.storminess,
      windSpeed: Math.max(0.35, Math.min(2.5, state.windSpeed / 14)),
      rainbow: 0,
      aurora: 0
    };
    activeTimeName = `${state.location.city} (${state.localTimeStr})`;
    activeWeatherName = `${state.temperature}° ${state.conditionLabel}`;
    pushToShader();
  };

  document.getElementById('btn-live-host')?.addEventListener('click', () => {
    if (hostState) applyLiveWeatherState(hostState, 'btn-live-host');
  });

  document.getElementById('btn-live-visitor')?.addEventListener('click', () => {
    if (visitorState) applyLiveWeatherState(visitorState, 'btn-live-visitor');
  });

  // Fetch both live locations in background so the buttons show live city & temp
  fetchWeatherForLocation(HOST_LOCATION).then((state) => {
    hostState = state;
    const el = document.getElementById('host-mini-label');
    if (el) el.textContent = `${state.location.city} ${state.temperature}°`;
  });

  detectVisitorLocation()
    .then((loc) => fetchWeatherForLocation(loc))
    .then((state) => {
      visitorState = state;
      const el = document.getElementById('visitor-mini-label');
      if (el) el.textContent = `${state.location.city} ${state.temperature}°`;
    });

  // Start in Sunny Afternoon default so user immediately sees clouds + sun rays + bloom
  pushToShader();
</script>

<style>
  .sandbox-panel {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 10;
    width: min(390px, calc(100vw - 2.5rem));
    max-height: calc(100svh - 2.5rem);
    display: flex;
    flex-direction: column;
    background: rgba(12, 22, 38, 0.56);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 22px;
    color: #fff;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.32);
    overflow: hidden;
    transition: width 0.25s ease, background 0.25s ease;
  }

  .sandbox-panel.is-collapsed {
    width: auto;
  }

  .sandbox-panel.is-collapsed .panel-body,
  .sandbox-panel.is-collapsed .panel-title-wrap {
    display: none;
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .sandbox-panel.is-collapsed .panel-header {
    border-bottom: none;
    padding: 0.5rem 0.65rem;
  }

  .panel-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #69f0ae;
    box-shadow: 0 0 10px #69f0ae;
  }

  .panel-title {
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .collapse-btn {
    appearance: none;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.3rem 0.68rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .collapse-btn:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .panel-body {
    padding: 0.95rem 1.1rem 1.15rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    scrollbar-width: thin;
  }

  .control-section {
    display: flex;
    flex-direction: column;
    gap: 0.48rem;
  }

  .section-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.72);
  }

  .live-readout {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
    color: #9be7ff;
  }

