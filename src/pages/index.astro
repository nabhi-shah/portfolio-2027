---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ShaderCanvas from '@/components/ShaderCanvas.astro';
---

<BaseLayout>
  <ShaderCanvas />

  <main class="shell">
    <header class="topbar">
      <span class="brand">NABHI SHAH</span>
      <span class="status">2027 EDITION // WEBGL READY</span>
    </header>

    <section class="hero">
      <p class="eyebrow">CREATIVE TECHNOLOGY &amp; INTERACTIVE SHADERS</p>
      <h1 class="headline">Portfolio 2027</h1>
      <p class="subcopy">
        Zero-JS static HTML shell with deferred OGL / Three.js &amp; GLSL shader pipeline.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .shell {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.25rem;
  }

  .brand {
    color: var(--fg);
    font-weight: 600;
  }

  .hero {
    margin: auto 0;
    max-width: 48rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .headline {
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.96;
    margin-bottom: 1.5rem;
  }

  .subcopy {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.6;
    color: var(--muted);
    max-width: 36rem;
  }
</style>
